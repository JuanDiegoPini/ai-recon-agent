# LLM providers. Use separate, revocable development keys.
IA_API_KEY=
IA_MODELO=groq:qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Comma-separated exact hosts or wildcard subdomains (for example *.lab.local).
RECON_AUTHORIZED_TARGETS=localhost,127.0.0.1

# Required for Nmap, WhatWeb, remote curl, DNS, TLS, and browser checks.
# Set only when you have explicit permission for every target.
RECON_ACTIVE_ACK=I_HAVE_EXPLICIT_AUTHORIZATION

# Optional local source review. Dependency audit is disabled by default.
RECON_PROJECT_ROOT=
RECON_ENABLE_AUDIT=0

# Kali VirtualBox lab. Add host keys to known_hosts before first use.
VBOXMANAGE_PATH=C:\Program Files\Oracle\VirtualBox\VBoxManage.exe
JUAN_VM_NAME=
JUAN_VM_IP=
JUAN_VM_USER=
JUAN_VM_PASSWORD=
ANGEL_VM_NAME=
ANGEL_VM_IP=
ANGEL_VM_USER=
ANGEL_VM_PASSWORD=
SSH_COMMAND_TIMEOUT_SECONDS=30

